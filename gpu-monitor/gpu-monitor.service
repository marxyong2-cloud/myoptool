[Unit]
Description=MTT S5000 GPU Monitor Dashboard (mthreads-gmi web)
After=network.target

[Service]
Type=simple
User=mccxadmin
WorkingDirectory=/home/mccxadmin/gpu_monitor
ExecStart=/usr/bin/python3 /home/mccxadmin/gpu_monitor/server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
